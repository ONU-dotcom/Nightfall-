-- Hardwired Button Generator Block (Eliminates layout compilation loops)
local function createHardwiredButton(label, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 226, 0, 31)
    btn.Position = UDim2.new(0, 7, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
    btn.BorderColor3 = Color3.fromRGB(25, 25, 25)
    btn.Text = "  " .. label
    btn.Font = Enum.Font.SourceSans
    btn.TextSize = 13
    btn.TextColor3 = Color3.fromRGB(160, 160, 160)
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = BasePanel

    local ind = Instance.new("TextLabel")
    ind.Size = UDim2.new(0, 45, 1, 0)
    ind.Position = UDim2.new(1, -50, 0, 0)
    ind.BackgroundTransparency = 1
    ind.Text = "OFF"
    ind.Font = Enum.Font.SourceSansBold
    ind.TextSize = 12
    ind.TextColor3 = Color3.fromRGB(140, 140, 140)
    ind.TextXAlignment = Enum.TextXAlignment.Center
    ind.Parent = btn

    local toggle = false
    btn.MouseButton1Click:Connect(function()
        toggle = not toggle
        ind.Text = toggle and "ON" or "OFF"
        ind.TextColor3 = toggle and Color3.fromRGB(0, 220, 100) or Color3.fromRGB(140, 140, 140)
        btn.BackgroundColor3 = toggle and Color3.fromRGB(16, 22, 18) or Color3.fromRGB(12, 12, 12)
        btn.BorderColor3 = toggle and Color3.fromRGB(30, 50, 35) or Color3.fromRGB(25, 25, 25)
        callback(toggle)
    end)
end

