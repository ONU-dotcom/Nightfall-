-- Hardwired Technical Button Swapper Factory
local function createMenuButton(cleanLabel, placementIndex, actionCallback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 31)
    btn.BackgroundColor3 = Color3.fromRGB(15, 15, 18) -- Carbon Charcoal Row base plate
    btn.BorderColor3 = Color3.fromRGB(28, 30, 36)
    btn.BorderSizePixel = 1
    btn.Text = "  " .. cleanLabel .. " [OFF]"
    btn.TextColor3 = Color3.fromRGB(160, 160, 165) -- Formal Off-White Text
    btn.Font = Enum.Font.Ubuntu -- Professional High-Legibility Typeface Style
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left -- Clean formal alignment
    btn.LayoutOrder = placementIndex
    
    local activeToggleState = false
    btn.MouseButton1Click:Connect(function()
        activeToggleState = not activeToggleState
        if activeToggleState then
            btn.Text = "  " .. cleanLabel .. " [ON]"
            btn.TextColor3 = Color3.fromRGB(255, 255, 255) 
            btn.BackgroundColor3 = Color3.fromRGB(16, 26, 20) -- Emerald row highlight on select
            btn.BorderColor3 = Color3.fromRGB(0, 220, 100)
        else
            btn.Text = "  " .. cleanLabel .. " [OFF]"
            btn.TextColor3 = Color3.fromRGB(160, 160, 165)
            btn.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
            btn.BorderColor3 = Color3.fromRGB(28, 30, 36)
        end
        actionCallback(activeToggleState)
    end)
    
    btn.Parent = ContentContainer
    return btn
end

