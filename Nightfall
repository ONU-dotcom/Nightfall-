-- Main Display Management Thread Coordinator Loop
task.spawn(function()
    while task.wait(0.2) do
        _G.validateActiveTracking()
        local itemPool, mobPool, planePool = _G.locateAllTargets()
        
        -- Always-On Automatic Plane Text Tracker (NO Blinding Glow Box)
        for _, plane in ipairs(planePool) do
            _G.applyTrackingESP(plane, Color3.fromRGB(0, 160, 255), "✈️ Plane", false)
        end
        
        -- Resource Item ESP Processing Lane
        if _G.ESP_Enabled then
            for _, data in ipairs(itemPool) do
                local obj = data.Instance
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if part and part.Transparency < 0.8 and part.CanCollide then
                    if data.Type == "Rock" then _G.applyTrackingESP(obj, Color3.fromRGB(160, 160, 160), "🪨 Rock", true)
                    elseif data.Type == "Stick" then _G.applyTrackingESP(obj, Color3.fromRGB(150, 110, 80), "🪾 Stick", true)
                    elseif data.Type == "Cherry" then _G.applyTrackingESP(obj, Color3.fromRGB(255, 30, 60), "🍒 Cherry", true) end
                end
            end
        else
            for i = #_G.Active_ESP_Boxes, 1, -1 do
                local box = _G.Active_ESP_Boxes[i]
                if box.inst and not box.inst:FindFirstChildOfClass("Humanoid") and box.inst.Name ~= "Plane" and not box.inst.Name:find("Plane") then
                    if box.inst:FindFirstChild("ONUE_ESP") then box.inst.ONUE_ESP:Destroy() end
                    if box.inst:FindFirstChild("ONUE_Label") then box.inst.ONUE_Label:Destroy() end
                    table.remove(_G.Active_ESP_Boxes, i)
                end
            end
        end
        
        -- Night Monster ESP Folder Processing Lane
        if _G.Monster_ESP_Enabled then
            for _, mob in ipairs(mobPool) do
                _G.applyTrackingESP(mob, Color3.fromRGB(255, 10, 20), "👹 Monster", true)
            end
        else
            for i = #_G.Active_ESP_Boxes, 1, -1 do
                local box = _G.Active_ESP_Boxes[i]
                if box.inst and box.inst:FindFirstChildOfClass("Humanoid") then
                    if box.inst:FindFirstChild("ONUE_ESP") then box.inst.ONUE_ESP:Destroy() end
                    if box.inst:FindFirstChild("ONUE_Label") then box.inst.ONUE_Label:Destroy() end
                    table.remove(_G.Active_ESP_Boxes, i)
                end
            end
        end
    end
end)
