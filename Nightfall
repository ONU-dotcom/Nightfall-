-- 3. Professional Uniform Button Construction Factory
local function createMenuButton(cleanLabel, placementIndex, actionCallback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 28)
    btn.BackgroundColor3 = Color3.fromRGB(28, 32, 38) -- Uniform Row Surface Gray
    btn.BorderColor3 = Color3.fromRGB(44, 48, 56)
    btn.BorderSizePixel = 1
    btn.Text = "  " .. cleanLabel .. " : OFF"
    btn.TextColor3 = Color3.fromRGB(150, 155, 165)
    btn.Font = Enum.Font.Roboto
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = placementIndex
    
    local RowCorner = Instance.new("UICorner")
    RowCorner.CornerRadius = UDim.new(0, 3)
    RowCorner.Parent = btn
    
    local activeToggleState = false
    btn.MouseButton1Click:Connect(function()
        activeToggleState = not activeToggleState
        if activeToggleState then
            btn.Text = "  " .. cleanLabel .. " : ACTIVE"
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.BackgroundColor3 = Color3.fromRGB(38, 45, 56) -- Elegant professional slate selection tint
            btn.BorderColor3 = Color3.fromRGB(70, 100, 140)
        else
            btn.Text = "  " .. cleanLabel .. " : OFF"
            btn.TextColor3 = Color3.fromRGB(150, 155, 165)
            btn.BackgroundColor3 = Color3.fromRGB(28, 32, 38)
            btn.BorderColor3 = Color3.fromRGB(44, 48, 56)
        end
        actionCallback(activeToggleState)
    end)
    
    btn.Parent = ContentContainer
    return btn
end

