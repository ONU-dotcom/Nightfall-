-- 1. Highly Optimized Focused Resource & Monster Scanner Engine
function _G.locateGameTargets()
    local resources = {}
    local monsters = {}
    local planes = {}
    
    -- Performance Scan: Target exact structural directories instead of full workspace tree
    local targets = {}
    local itemFolder = Workspace:FindFirstChild("Items") or Workspace:FindFirstChild("Resources")
    
    if itemFolder then
        targets = itemFolder:GetChildren()
    else
        targets = Workspace:GetChildren() -- Fallback if world directories are flat
    end
    
    for _, obj in ipairs(targets) do
        local name = obj.Name:lower()
        
        -- Filter out blueprint or player construction assets immediately
        local isBlueprint = name:find("blueprint") or name:find("camp") or name:find("fire")
        
        if not isBlueprint then
            if name:find("plane") then
                if obj:IsA("Model") or obj:IsA("BasePart") then
                    table.insert(planes, obj)
                end
            elseif obj:IsA("BasePart") or obj:IsA("Model") then
                local isRock = name:find("rock")
                local isStick = name:find("stick")
                local isCherry = name:find("cherry") or name:find("berry")
                
                if isRock or isStick or isCherry then
                    local itemType = "Cherry"
                    if isRock then itemType = "Rock" end
                    if isStick then itemType = "Stick" end
                    
                    table.insert(resources, { Instance = obj, Type = itemType })
                end
            end
        end
    end
    
    -- Isolated Monster Folder Streaming Pass
    local monstersFolder = Workspace:FindFirstChild("Monsters")
    if monstersFolder then
        for _, creature in ipairs(monstersFolder:GetChildren()) do
            if creature.Name == "Feral_Active" or creature:FindFirstChildOfClass("Humanoid") then
                if creature.Name ~= "Sheep" and creature.Name ~= "Deer" and creature.Name ~= LocalPlayer.Name then
                    table.insert(monsters, creature)
                end
            end
        end
    end
    
    return resources, monsters, planes
end

-- 2. Professional Geometric Overlay Pipeline
function _G.applyTrackingESP(instance, color, displayName, useHighlight)
    if instance:FindFirstChild("ONUE_Label") then return end

    if useHighlight and not instance:FindFirstChild("ONUE_ESP") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "ONUE_ESP"
        highlight.FillColor = color
        highlight.FillTransparency = 0.6
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0.2
        highlight.Adornee = instance
        highlight.Parent = instance
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ONUE_Label"
    billboard.Size = UDim2.new(0, 120, 0, 25)
    billboard.AlwaysOnTop = true
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Adornee = instance

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = color
    textLabel.TextStrokeTransparency = 0.4
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Font = Enum.Font.Roboto
    textLabel.TextSize = 12
    textLabel.Text = displayName
    textLabel.Parent = billboard
    
    billboard.Parent = instance
    table.insert(_G.Active_ESP_Boxes, {inst = instance, high = instance:FindFirstChild("ONUE_ESP"), bill = billboard})
end

-- 3. High-Frequency Garbage Collection Node
function _G.validateActiveTracking()
    for i = #_G.Active_ESP_Boxes, 1, -1 do
        local data = _G.Active_ESP_Boxes[i]
        local shouldClear = false
        
        if not data.inst or not data.inst.Parent or not data.inst:IsDescendantOf(Workspace) then
            shouldClear = true
        else
            local part = data.inst:IsA("BasePart") and data.inst or data.inst:FindFirstChildWhichIsA("BasePart")
            local hum = data.inst:FindFirstChildOfClass("Humanoid")
            
            if hum and hum.Health <= 0 then
                shouldClear = true
            elseif part and (part.Transparency >= 0.8 or not part.CanCollide) then
                shouldClear = true
            end
        end
        
        if shouldClear then
            local targetInstance = data.inst
            if targetInstance then
                local oldEsp = targetInstance:FindFirstChild("ONUE_ESP")
                local oldLabel = targetInstance:FindFirstChild("ONUE_Label")
                if oldEsp then oldEsp:Destroy() end
                if oldLabel then oldLabel:Destroy() end
            end
            table.remove(_G.Active_ESP_Boxes, i)
        end
    end
end
-- CFrame Vector Speed Translator Hook
function _G.updateSpeedHack()
    if _G.SpeedConnection then _G.SpeedConnection:Disconnect() end
    if _G.Speed_Enabled then
        _G.SpeedConnection = RunService.Heartbeat:Connect(function(deltaTime)
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and rootPart and humanoid.MoveDirection.Magnitude > 0 then
                rootPart.CFrame = rootPart.CFrame + (humanoid.MoveDirection * (_G.Target_Speed - humanoid.WalkSpeed) * deltaTime)
            end
        end)
    end
end

-- Controlled Fast Chop Automation Processing Layer
task.spawn(function()
    while true do
        task.wait(0.12) -- Optimized cadence: Rapid but human-fast execution to prevent network drops
        
        if _G.AutoFarm_Trees_Enabled then
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if character then
                for _, tool in ipairs(character:GetChildren()) do
                    if tool:IsA("Tool") then tool:SetAttribute("AxeLocalBusyUntil", nil) end
                end
            end
            
            if rootPart then
                -- Spatial awareness lookup query instead of scanning thousands of workspace parts
                local overlapParams = OverlapParams.new()
                overlapParams.FilterType = Enum.RaycastFilterType.Include
                
                local treeFolder = Workspace:FindFirstChild("Trees") or Workspace
                overlapParams.FilterDescendantsInstances = {treeFolder}
                
                local nearbyParts = Workspace:GetPartBoundsInRadius(rootPart.Position, 16, overlapParams)
                
                for _, obj in ipairs(nearbyParts) do
                    if obj.Name == "TreeHitbox" and obj:IsA("BasePart") then
                        local current = obj.Parent
                        local treeModel = nil
                        while current and current ~= Workspace do
                            if current:IsA("Model") and current:GetAttribute("Hitpoints") ~= nil then
                                treeModel = current
                                break
                            end
                            current = current.Parent
                        end
                        
                        if treeModel and treeModel:GetAttribute("Broken") ~= true then
                            local treeId = treeModel:GetAttribute("WorldGenTreeId") or treeModel:GetAttribute("GeneratedTreeId")
                            if typeof(treeId) == "string" then
                                -- Regulated fast attack dual packet execution sequence
                                _G.AxeRemote:FireServer(treeId)
                                _G.AxeRemote:FireServer(treeId)
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- Main Display Refresh Thread Management Node
task.spawn(function()
    while task.wait(0.25) do
        _G.validateActiveTracking()
        local itemPool, mobPool, planePool = _G.locateGameTargets()
        
        -- Always-On Silent Plane Monitor Passage
        for _, plane in ipairs(planePool) do
            _G.applyTrackingESP(plane, Color3.fromRGB(0, 160, 255), "Plane Target", false)
        end
        
        -- Item ESP Execution Matrix
        for _, data in ipairs(itemPool) do
            local obj = data.Instance
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part and part.Transparency < 0.8 and part.CanCollide then
                if data.Type == "Rock" and _G.Rock_ESP_Enabled then 
                    _G.applyTrackingESP(obj, Color3.fromRGB(170, 175, 180), "Rock", true)
                elseif data.Type == "Stick" and _G.Stick_ESP_Enabled then 
                    _G.applyTrackingESP(obj, Color3.fromRGB(160, 125, 95), "Stick", true)
                elseif data.Type == "Cherry" and _G.Cherry_ESP_Enabled then 
                    _G.applyTrackingESP(obj, Color3.fromRGB(240, 50, 75), "Cherry", true)
                end
            end
        end
        
        -- Fallback cleanup handling for turned-off categories
        for i = #_G.Active_ESP_Boxes, 1, -1 do
            local box = _G.Active_ESP_Boxes[i]
            if box.inst and box.inst.Name ~= "Plane" and not box.inst.Name:find("Plane") and not box.inst:FindFirstChildOfClass("Humanoid") then
                local label = box.bill:FindFirstChildOfClass("TextLabel")
                local labelText = label and label.Text or ""
                
                if (labelText == "Rock" and not _G.Rock_ESP_Enabled) or
                   (labelText == "Stick" and not _G.Stick_ESP_Enabled) or
                   (labelText == "Cherry" and not _G.Cherry_ESP_Enabled) then
                    if box.inst:FindFirstChild("ONUE_ESP") then box.inst.ONUE_ESP:Destroy() end
                    if box.inst:FindFirstChild("ONUE_Label") then box.inst.ONUE_Label:Destroy() end
                    table.remove(_G.Active_ESP_Boxes, i)
                end
            end
        end
        
        -- Monster Tracking Stream
        if _G.Monster_ESP_Enabled then
            for _, mob in ipairs(mobPool) do
                _G.applyTrackingESP(mob, Color3.fromRGB(235, 40, 40), "Target Hostile", true)
            end
        else
            for i = #_G.Active_ESP_Boxes, 1, -1 do
                local box = _G.Active_ESP_Boxes[i]
                if box.inst and box.inst:FindFirstChildOfClass("Humanoid") then
                    if box.inst:FindFirstChild("ONUE_ESP") then box.inst.ONUE_ESP:Destroy() end
                    if box.inst:FindFirstChild("ONUE_Label") then box.inst.ONUE_Label:Destroy() end
                    table.remove(_G.Active_ESP_Boxes, i)
                end
            end
        end
    end
end)
