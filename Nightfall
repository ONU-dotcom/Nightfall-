-- Hardwired Button Generator Block (Manually placed to prevent list compilation crashes)
local function createHardwiredButton(label, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 226, 0, 31)
    btn.Position = UDim2.new(0, 7, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(13, 13, 16) -- Deep Charcoal Row Plates
    btn.BorderColor3 = Color3.fromRGB(26, 26, 32)
    btn.BorderSizePixel = 1
    btn.Text = "  " .. label
    btn.Font = Enum.Font.SourceSans -- Formal Left-Aligned Technical Typography Style
    btn.TextSize = 13
    btn.TextColor3 = Color3.fromRGB(170, 170, 180) -- Cool Silver Gray Text
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = BasePanel

    local ind = Instance.new("TextLabel")
    ind.Size = UDim2.new(0, 45, 1, 0)
    ind.Position = UDim2.new(1, -50, 0, 0)
    ind.BackgroundTransparency = 1
    ind.Text = "OFF"
    ind.Font = Enum.Font.SourceSansBold
    ind.TextSize = 12
    ind.TextColor3 = Color3.fromRGB(140, 140, 145)
    ind.TextXAlignment = Enum.TextXAlignment.Center
    ind.Parent = btn

    local toggle = false
    btn.MouseButton1Click:Connect(function()
        toggle = not toggle
        ind.Text = toggle and "ON" or "OFF"
        ind.TextColor3 = toggle and Color3.fromRGB(0, 225, 105) or Color3.fromRGB(140, 140, 145) -- Emerald Active State
        btn.BackgroundColor3 = toggle and Color3.fromRGB(16, 24, 19) or Color3.fromRGB(13, 13, 16)
        btn.BorderColor3 = toggle and Color3.fromRGB(30, 55, 35) or Color3.fromRGB(26, 26, 32)
        callback(toggle)
    end)
end

